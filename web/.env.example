# Public Privy app id from dashboard.privy.io, safe to expose to the browser
NEXT_PUBLIC_PRIVY_APP_ID=

# Server only Privy app secret, never prefixed with NEXT_PUBLIC, unused until a backend needs it
PRIVY_APP_SECRET=

# Neon Postgres connection string, added by the Vercel Storage integration
DATABASE_URL=

# Privy authorization key private key, app controlled agent wallets, unused until Milestone 4
PRIVY_AUTHORIZATION_KEY=

# Authorization keypair that owns agent wallets, generated with pnpm auth:key
PRIVY_AUTHORIZATION_KEY=
PRIVY_AUTHORIZATION_PUBLIC_KEY=

# Platform master wallet that funds agent wallets, created with pnpm wallet:master
MASTER_WALLET_ID=
MASTER_WALLET_ADDRESS=

# Public base URL used to build ERC-8004 agent URIs, set to https://twofield.dev when the domain is live
NEXT_PUBLIC_APP_URL=

# Anthropic API key, used from Milestone 8 to generate seller deliverables
ANTHROPIC_API_KEY=

# Platform evaluator wallet for ERC-8183 jobs, created in Milestone 7
EVALUATOR_WALLET_ID=
EVALUATOR_WALLET_ADDRESS=

# Privy DID of the platform owner, the only user who sees the review queue
NEXT_PUBLIC_PLATFORM_OWNER_ID=
