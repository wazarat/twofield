# Public Privy app id from dashboard.privy.io, safe to expose to the browser
NEXT_PUBLIC_PRIVY_APP_ID=

# Server only Privy app secret, never prefixed with NEXT_PUBLIC, unused until a backend needs it
PRIVY_APP_SECRET=

# Neon Postgres connection string, added by the Vercel Storage integration
DATABASE_URL=

# Privy authorization key private key, app controlled agent wallets, unused until Milestone 4
PRIVY_AUTHORIZATION_KEY=
