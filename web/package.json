{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:key": "node --no-warnings scripts/generate-auth-key.ts",
    "wallet:master": "node --no-warnings --env-file=.env.local scripts/create-master-wallet.ts",
    "sellers:seed": "node --no-warnings --experimental-transform-types --env-file=.env.local --import ./scripts/register-alias.mjs scripts/seed-sellers.ts",
    "wallet:evaluator": "node --no-warnings --experimental-transform-types --env-file=.env.local --import ./scripts/register-alias.mjs scripts/create-evaluator-wallet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@neondatabase/serverless": "^1.1.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.40.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.11",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@next/env": "^16.3.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
